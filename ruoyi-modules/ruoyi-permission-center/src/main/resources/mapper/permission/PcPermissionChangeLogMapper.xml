<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.permission.mapper.PcPermissionChangeLogMapper">

    <resultMap id="ChangeLogResultMap" type="org.dromara.permission.domain.PcPermissionChangeLog">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="biz_domain_id" property="bizDomainId"/>
        <result column="entity_type" property="entityType"/>
        <result column="entity_id" property="entityId"/>
        <result column="operation" property="operation"/>
        <result column="old_snapshot" property="oldSnapshot"/>
        <result column="new_snapshot" property="newSnapshot"/>
        <result column="affected_abstract_user_ids" property="affectedAbstractUserIds"
                typeHandler="org.dromara.permission.handler.PgLongArrayToStringTypeHandler"/>
        <result column="affected_abstract_role_ids" property="affectedAbstractRoleIds"
                typeHandler="org.dromara.permission.handler.PgLongArrayToStringTypeHandler"/>
        <result column="change_reason" property="changeReason"/>
        <result column="change_source" property="changeSource"/>
        <result column="request_id" property="requestId"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectChangeLogPage" resultMap="ChangeLogResultMap">
        SELECT id, tenant_id, biz_domain_id, entity_type, entity_id, operation,
               old_snapshot, new_snapshot, affected_abstract_user_ids, affected_abstract_role_ids,
               change_reason, change_source, request_id, created_by, created_at
        FROM permission_change_log
        <where>
            <if test="bo.tenantId != null">
                AND tenant_id = #{bo.tenantId}
            </if>
            <if test="bo.abstractUserId != null">
                AND #{bo.abstractUserId} = ANY(affected_abstract_user_ids)
            </if>
            <if test="bo.abstractRoleId != null">
                AND #{bo.abstractRoleId} = ANY(affected_abstract_role_ids)
            </if>
            <if test="bo.bizDomainId != null">
                AND biz_domain_id = #{bo.bizDomainId}
            </if>
            <if test="bo.entityType != null and bo.entityType != ''">
                AND entity_type = #{bo.entityType}
            </if>
            <if test="bo.requestId != null and bo.requestId != ''">
                AND request_id = #{bo.requestId}
            </if>
            <if test="bo.beginTime != null">
                AND created_at &gt;= #{bo.beginTime}
            </if>
            <if test="bo.endTime != null">
                AND created_at &lt;= #{bo.endTime}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>
</mapper>
