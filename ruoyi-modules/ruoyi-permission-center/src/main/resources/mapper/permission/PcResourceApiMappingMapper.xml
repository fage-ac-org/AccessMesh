<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.permission.mapper.PcResourceApiMappingMapper">

    <resultMap id="ResourceApiMappingResultMap" type="org.dromara.permission.domain.PcResourceApiMapping">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="biz_domain_id" property="bizDomainId"/>
        <result column="resource_entity_id" property="resourceEntityId"/>
        <result column="service_code" property="serviceCode"/>
        <result column="http_method" property="httpMethod"/>
        <result column="path_pattern" property="pathPattern"/>
        <result column="match_order" property="matchOrder"/>
        <result column="enabled" property="enabled"/>
        <result column="extra" property="extra"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_by" property="deletedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="delete_flag" property="deleteFlag"/>
    </resultMap>

    <select id="selectEnabledByTenantAndResourceIds" resultMap="ResourceApiMappingResultMap">
        SELECT id, tenant_id, biz_domain_id, resource_entity_id, service_code, http_method, path_pattern,
               match_order, enabled, extra, created_by, updated_by, deleted_by, created_at, updated_at,
               deleted_at, delete_flag
        FROM resource_api_mapping
        WHERE tenant_id = #{tenantId}
          AND delete_flag = 0
          AND enabled = TRUE
          AND resource_entity_id IN
        <foreach collection="resourceEntityIds" item="resourceEntityId" open="(" separator="," close=")">
            #{resourceEntityId}
        </foreach>
        ORDER BY match_order ASC, id ASC
    </select>
</mapper>
